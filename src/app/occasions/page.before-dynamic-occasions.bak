import {Suspense} from "react";
import Link from "next/link";
import {ArrowUpRight,ArrowLeft} from "lucide-react";
import {getProducts} from "@/lib/studio-products";

export const metadata={
  title:"The Occasion Edit | Vrinda Élle",
  description:"Discover curated jewellery, accessories and festive décor for meaningful occasions."
};

const edits=[
  {
    id:"haldi",
    number:"01",
    title:"Haldi & Mehendi",
    subtitle:"A little colour. A lot of joy.",
    description:"Floral details and playful accessories for celebrations filled with colour.",
    categories:["Floral Jewellery","Hair Accessories"],
    words:["floral","flower","haldi","mehendi","hairband"]
  },
  {
    id:"wedding",
    number:"02",
    title:"Wedding Moments",
    subtitle:"For the moments you remember.",
    description:"Elegant accents and thoughtful finishing touches for wedding celebrations.",
    categories:["Pearl Jewellery","Floral Jewellery"],
    words:["pearl","necklace","bangle","jewellery"]
  },
  {
    id:"festive",
    number:"03",
    title:"Festive Celebrations",
    subtitle:"Make every corner feel special.",
    description:"Decorative details and festive favourites for gatherings close to the heart.",
    categories:["Festive Décor"],
    words:["festive","candle","hanging","shubh","diya"]
  },
  {
    id:"gifting",
    number:"04",
    title:"The Gifting Edit",
    subtitle:"Little gestures. Lasting memories.",
    description:"Discover charming pieces to celebrate someone special.",
    categories:["Accessories","Hair Accessories","Pearl Jewellery"],
    words:["charm","accessory","pearl","gift"]
  },
  {
    id:"everyday",
    number:"05",
    title:"Everyday Elegance",
    subtitle:"A little luxury, every day.",
    description:"Versatile details for the days that deserve something beautiful.",
    categories:["Accessories","Pearl Jewellery"],
    words:["necklace","charm","accessory"]
  }
];

function matches(product,edit){
  const text=`${product.name} ${product.category}`.toLowerCase();
  return edit.categories.includes(product.category)||edit.words.some(word=>text.includes(word));
}

async function OccasionsContent(){
  const products=(await getProducts()).filter(p=>p.status==="published"&&p.image);
  return <main className="min-h-screen bg-[#211b18] text-[#e3d6c4]">
    <section className="relative overflow-hidden px-[6%] pb-20 pt-40 md:pb-28 md:pt-52">
      <div className="pointer-events-none absolute right-0 top-10 h-96 w-96 rounded-full bg-[#c5a572]/10 blur-[110px]"/>
      <div className="relative mx-auto max-w-7xl">
        <Link href="/collections" className="inline-flex items-center gap-2 text-xs text-[#c5a572] transition hover:text-[#e3d6c4]">
          <ArrowLeft size={15}/> Back to Collections
        </Link>
        <p className="mt-14 text-[10px] uppercase tracking-[.35em] text-[#c5a572]">CURATED FOR YOUR MOMENTS</p>
        <h1 className="mt-6 font-serif text-[clamp(52px,8vw,116px)] leading-[.9] tracking-tight">
          The Occasion<br/><em className="font-normal text-[#c5a572]">Edit.</em>
        </h1>
        <p className="mt-9 max-w-xl text-sm leading-8 text-[#b7b2ac]">
          Every celebration has a story. Find beautiful little details for the moments that matter.
        </p>
        <div className="mt-12 flex flex-wrap gap-3">
          {edits.map(edit=><a key={edit.id} href={`#${edit.id}`} className="rounded-full border border-[#c5a572]/30 px-5 py-3 text-[11px] text-[#e3d6c4] transition hover:border-[#c5a572] hover:bg-[#c5a572]/10">{edit.title}</a>)}
        </div>
      </div>
    </section>

    <div className="mx-auto max-w-7xl px-[6%] pb-28">
      {edits.map((edit,index)=>{
        const selected=products.filter(p=>matches(p,edit)).slice(0,4);
        return <section key={edit.id} id={edit.id} className="scroll-mt-28 border-t border-[#c5a572]/20 py-16 md:py-24">
          <div className="mb-10 flex flex-wrap items-end justify-between gap-6">
            <div>
              <span className="text-[10px] tracking-[.3em] text-[#c5a572]">THE OCCASION EDIT / {edit.number}</span>
              <h2 className="mt-5 font-serif text-[clamp(36px,5vw,68px)] leading-none">{edit.title}<span className="text-[#c5a572]">.</span></h2>
              <p className="mt-4 font-serif text-2xl italic text-[#c5a572]">{edit.subtitle}</p>
              <p className="mt-5 max-w-lg text-sm leading-7 text-[#b7b2ac]">{edit.description}</p>
            </div>
            <Link href="/collections" className="inline-flex items-center gap-2 border-b border-[#c5a572]/60 pb-2 text-xs text-[#c5a572]">Explore Collections <ArrowUpRight size={16}/></Link>
          </div>

          {selected.length>0?
            <div className="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
              {selected.map(p=><Link key={p.slug} href={`/jewellery/${p.slug}`} className="group min-w-0">
                <div className="relative aspect-[4/5] overflow-hidden bg-[#302824]">
                  <img src={p.image} alt={p.name} loading="lazy" decoding="async" className="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"/>
                  <span className="absolute bottom-3 right-3 flex h-9 w-9 items-center justify-center rounded-full bg-[#211b18]/85 text-[#c5a572]"><ArrowUpRight size={17}/></span>
                </div>
                <p className="mt-4 text-[9px] uppercase tracking-[.15em] text-[#c5a572]">{p.category}</p>
                <h3 className="mt-2 font-serif text-lg leading-tight md:text-2xl">{p.name}</h3>
                <p className="mt-2 text-[10px] text-[#b7b2ac]">{p.code}</p>
              </Link>)}
            </div>
            :<div className="border border-[#c5a572]/20 bg-[#302824]/50 px-6 py-10 text-center">
              <p className="font-serif text-2xl">More beautiful pieces coming soon.</p>
              <p className="mt-3 text-sm text-[#b7b2ac]">Explore our current collection in the meantime.</p>
              <Link href="/collections" className="mt-5 inline-flex items-center gap-2 text-xs text-[#c5a572]">Browse Collections <ArrowUpRight size={15}/></Link>
            </div>
          }
        </section>;
      })}
      <section className="mt-8 border border-[#c5a572]/25 bg-[#302824] px-6 py-16 text-center md:px-12 md:py-24">
        <p className="text-[10px] tracking-[.3em] text-[#c5a572]">PERSONAL ENQUIRIES</p>
        <h2 className="mt-6 font-serif text-[clamp(36px,5vw,65px)] leading-tight">Something special<br/><em className="text-[#c5a572]">in mind?</em></h2>
        <p className="mx-auto mt-6 max-w-lg text-sm leading-7 text-[#b7b2ac]">Tell us about your occasion and the designs you love.</p>
        <a href="https://wa.me/919530079054?text=Hello%20Vrinda%20%C3%89lle%2C%20I%20would%20like%20to%20enquire%20about%20products%20for%20an%20occasion." target="_blank" rel="noopener noreferrer" className="mt-9 inline-flex items-center gap-3 bg-[#c5a572] px-8 py-4 text-xs font-medium text-[#211b18] transition hover:bg-[#e3d6c4]">Enquire on WhatsApp <ArrowUpRight size={17}/></a>
      </section>
    </div>
  </main>;
}


export default function OccasionsPage(){
  return <Suspense fallback={
    <main className="min-h-screen bg-[#211b18] px-[6%] pt-44 text-[#e3d6c4]">
      <p className="text-[10px] tracking-[.3em] text-[#c5a572]">
        THE OCCASION EDIT
      </p>
      <h1 className="mt-8 font-serif text-5xl italic">
        Curating beautiful moments...
      </h1>
    </main>
  }>
    <OccasionsContent/>
  </Suspense>;
}
